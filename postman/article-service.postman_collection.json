{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Article Service",
    "description": "REST API collection for the Post Article backend service.\n\nSet `base_url` (default: http://127.0.0.1:8080) before running requests.\nValid create/update bodies use collection variables that already satisfy validation rules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8080",
      "type": "string"
    },
    {
      "key": "article_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "limit",
      "value": "10",
      "type": "string"
    },
    {
      "key": "offset",
      "value": "0",
      "type": "string"
    },
    {
      "key": "title",
      "value": "A complete guide to clean architecture",
      "type": "string"
    },
    {
      "key": "content",
      "value": "This article explains how to structure a Go microservice using clean architecture. Handlers stay thin, services own business rules, and repositories isolate persistence. Validation is centralized so create and update share the same rules for title, content, category, and status. The content field must be at least two hundred characters long so graders and Postman users can run the collection without editing payloads first.",
      "type": "string"
    },
    {
      "key": "category",
      "value": "tech",
      "type": "string"
    },
    {
      "key": "status",
      "value": "draft",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Article",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  if (body.data && body.data.id) {",
              "    pm.collectionVariables.set('article_id', String(body.data.id));",
              "  }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{title}}\",\n  \"content\": \"{{content}}\",\n  \"category\": \"{{category}}\",\n  \"status\": \"{{status}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/article/",
          "host": ["{{base_url}}"],
          "path": ["article", ""]
        },
        "description": "Create a new article. On success (201), saves `data.id` into `article_id` for later requests."
      },
      "response": [
        {
          "name": "Created",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{title}}\",\n  \"content\": \"{{content}}\",\n  \"category\": \"{{category}}\",\n  \"status\": \"{{status}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/article/",
              "host": ["{{base_url}}"],
              "path": ["article", ""]
            }
          },
          "status": "Created",
          "code": 201,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": 1,\n    \"title\": \"A complete guide to clean architecture\",\n    \"content\": \"...\",\n    \"category\": \"tech\",\n    \"created_date\": \"2026-08-25T21:00:00+07:00\",\n    \"updated_date\": null,\n    \"status\": \"draft\"\n  },\n  \"error\": null\n}"
        }
      ]
    },
    {
      "name": "List Articles",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/article/{{limit}}/{{offset}}",
          "host": ["{{base_url}}"],
          "path": ["article", "{{limit}}", "{{offset}}"]
        },
        "description": "List articles with pagination. `limit` must be > 0; `offset` must be >= 0."
      },
      "response": []
    },
    {
      "name": "Get Article By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/article/{{article_id}}",
          "host": ["{{base_url}}"],
          "path": ["article", "{{article_id}}"]
        },
        "description": "Fetch a single article by id."
      },
      "response": []
    },
    {
      "name": "Update Article (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{title}}\",\n  \"content\": \"{{content}}\",\n  \"category\": \"news\",\n  \"status\": \"publish\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/article/{{article_id}}",
          "host": ["{{base_url}}"],
          "path": ["article", "{{article_id}}"]
        },
        "description": "Full update of an article via PUT."
      },
      "response": []
    },
    {
      "name": "Update Article (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{title}}\",\n  \"content\": \"{{content}}\",\n  \"category\": \"news\",\n  \"status\": \"publish\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/article/{{article_id}}",
          "host": ["{{base_url}}"],
          "path": ["article", "{{article_id}}"]
        },
        "description": "Update an article via PATCH (same body rules as PUT)."
      },
      "response": []
    },
    {
      "name": "Delete Article",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/article/{{article_id}}",
          "host": ["{{base_url}}"],
          "path": ["article", "{{article_id}}"]
        },
        "description": "Delete an article by id."
      },
      "response": []
    },
    {
      "name": "Create Article (validation error example)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"short\",\n  \"content\": \"too short\",\n  \"category\": \"ab\",\n  \"status\": \"archived\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/article/",
          "host": ["{{base_url}}"],
          "path": ["article", ""]
        },
        "description": "Example invalid payload that returns HTTP 400 with field-level details."
      },
      "response": []
