# HTTP server
APP_PORT=8080
APP_ENV=development

# MySQL connection (matches docker-compose.yml defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=article
DB_PASSWORD=article
DB_NAME=article

# Connection pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Request timeouts
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
